# Variáveis de ambiente do projeto C4Arch.
# Copie para .env e preencha os valores. NUNCA comite o .env real.
#
# Gere segredos fortes, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Banco de dados ──────────────────────────────────────────────
POSTGRES_USER=c4arch
# Use 24+ caracteres aleatórios fora do ambiente de demonstração.
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=c4arch
DB_HOST=db
DB_PORT=5432
DB_NAME=c4arch

# ── Aplicação API ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Obrigatório. Mínimo de 32 caracteres; a API recusa subir em produção
# com segredo fraco ou ausente.
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS (separadas por vírgula). Sem wildcard.
CORS_ORIGIN=http://localhost:3000

# Registro público e seed de demonstração. Em produção use false.
# Com SEED_DEMO=true em produção, DEMO_ADMIN_PASSWORD deve ter 12+ caracteres
# e não pode ser um valor de exemplo (admin123 etc.).
ALLOW_REGISTRATION=true
SEED_DEMO=true
DEMO_ADMIN_PASSWORD=admin123

# Defina true apenas atrás de um reverse proxy confiável (nginx/traefik).
TRUST_PROXY=false

# ── Endereço de bind das portas publicadas ──────────────────────
# 127.0.0.1 = acessível apenas na máquina local (padrão seguro).
# Use 0.0.0.0 somente quando a exposição for intencional.
BIND_ADDR=127.0.0.1

# ── URLs públicas usadas no build do frontend ───────────────────
# Precisam ser acessíveis pelo NAVEGADOR, não pela rede interna do Docker.
# Em produção, use https:// e wss:// (com reverse proxy).
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=ws://localhost:4001

# ── Realtime (Yjs) ──────────────────────────────────────────────
WS_PORT=4001
# Token de serviço opcional para hidratação server-to-server.
API_TOKEN_REALTIME=
# Deixe false: o WebSocket exige o token de sessão do usuário.
WS_ALLOW_ANONYMOUS=false

# ── Google Drive (adapter) ──────────────────────────────────────
# DRIVE_FOLDER_ID=0AB12CD34EF
# DRIVE_CLIENT_ID=change-me
# DRIVE_CLIENT_SECRET=change-me

# ── GitLab (adapter) ────────────────────────────────────────────
# GLAB_PROJECT_ID=group/project
# GLAB_TOKEN=change-me

# ── Autenticação SSO (Google) ───────────────────────────────────
# Login com Google via OAuth 2.0/OIDC. Deixe vazio para desabilitar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback registrada no Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# URL do frontend usada no redirecionamento após login SSO.
FRONTEND_URL=http://localhost:3000

# ── Onda 1: feature flags (off|shadow|on) ────────────────────────────────────
# Todas começam em off para preservar o comportamento atual. Ligue uma flag
# por vez, acompanhando as métricas em /metrics e os logs dos serviços.
#
# off    = caminho legado
# shadow = executa o caminho novo em paralelo, sem servir a resposta
# on     = caminho novo é a fonte da resposta
CANONICAL_MODEL=off
CANONICAL_VIEWS=off
DAS_OVERRIDES=off
VERSION_HASH=off
REALTIME_PG_STATE=off
PROJECTOR_SHADOW=off

# Telemetria (API). Em produção o /metrics fica desabilitado por padrão.
METRICS_ENABLED=true
# Loga tamanho de snapshots no realtime (útil no M0; desligue em produção).
TELEMETRY_VERBOSE=false

# Flags do frontend (resolvidas no build do Vite; precisam de rebuild da web).
VITE_CANONICAL_VIEWS=on
VITE_DAS_OVERRIDES=on
VITE_VERSION_HASH=on
