# Variaveis de ambiente do frontend C4Arch (carregadas pelo Vite).
# Copie para .env.local e ajuste conforme o ambiente.

# URL base do backend REST (API). Usada pelo service api.ts.
VITE_API_URL=http://localhost:4000

# URL base do websocket de sincronizacao em tempo real (realtime)
VITE_WS_URL=ws://localhost:4001

# Path do websocket (deve casar com o handler do realtime)
VITE_WS_PATH=/ws
